{
  "name": "nay-fiscal",
  "private": true,
  "version": "0.1.0",
  "description": "Nay Fiscal: auditoria de notas fiscais para a Reforma Tributaria",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w @nay/api\" \"npm run dev -w @nay/web\"",
    "build": "npm run build -w @nay/shared && npm run build -w @nay/api && npm run build -w @nay/web",
    "test": "npm run test --workspaces --if-present",
    "db:setup": "npm run db:setup -w @nay/api",
    "db:clear": "npm run db:clear -w @nay/api",
    "senha": "npm run senha -w @nay/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "checar-senhas": "npm run checar-senhas -w @nay/api",
    "start:web": "npm run build -w @nay/web && npm run start:web -w @nay/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1"
  }
}
