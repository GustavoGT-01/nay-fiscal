{
  "name": "@nay/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nay Fiscal: auditoria de notas fiscais para a Reforma Tributaria",
  "author": "Nay Fiscal",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "electronVersion": "33.4.11",
    "appId": "br.com.nayfiscal.app",
    "productName": "Nay Fiscal",
    "directories": { "output": "release" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "app", "to": "." }],
    "win": { "signAndEditExecutable": false, "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "language": "1046"
    },
    "npmRebuild": false
  }
}
