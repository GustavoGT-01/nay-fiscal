// Banco de dev: SQLite. Para producao troque provider para "postgresql".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Office {
  id        String    @id @default(cuid())
  name      String
  cnpj      String?
  plan      String    @default("padrao")
  createdAt DateTime  @default(now())
  users     User[]
  clients   Client[]
  profiles  Profile[]
}

model Profile {
  id          String  @id @default(cuid())
  officeId    String?
  office      Office? @relation(fields: [officeId], references: [id])
  name        String
  /// JSON: lista de chaves de tela/acao (ver @nay/shared SCREENS e ACTIONS)
  permissions String  @default("[]")
  users       User[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ANALISTA") // ADMIN | OWNER | ANALISTA
  active       Boolean  @default(true)
  // sobe a cada troca de senha/"sair de todos": tokens emitidos antes deixam de valer
  tokenVersion Int      @default(0)
  officeId     String
  office       Office   @relation(fields: [officeId], references: [id])
  profileId    String?
  profile      Profile? @relation(fields: [profileId], references: [id])
  createdAt    DateTime @default(now())
}

model Client {
  id             String          @id @default(cuid())
  officeId       String
  office         Office          @relation(fields: [officeId], references: [id])
  name           String
  tradeName      String?
  cnpj           String
  regime         String          @default("LUCRO_REAL") // SIMPLES_NACIONAL | LUCRO_PRESUMIDO | LUCRO_REAL | MEI
  city           String?
  cityCode       String?
  uf             String?
  cnae           String?
  createdAt      DateTime        @default(now())
  establishments Establishment[]
  documents      Document[]
  uploads        Upload[]
  auditRuns      AuditRun[]

  @@unique([officeId, cnpj])
}

model Establishment {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  cnpj      String
  isMatriz  Boolean @default(false)
}

model Upload {
  id          String     @id @default(cuid())
  /// escritorio dono do envio (o cliente pode ser detectado depois, pelo XML)
  officeId    String     @default("")
  /// cliente escolhido no envio; null = detectar pelo CNPJ das notas
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName    String
  skipped     Int        @default(0)
  /// JSON: nomes dos clientes criados automaticamente neste envio
  createdClients String  @default("[]")
  kind        String // XML | ZIP | SPED
  status      String     @default("PROCESSANDO") // PROCESSANDO | CONCLUIDO | ERRO
  total       Int        @default(0)
  processed   Int        @default(0)
  okCount     Int        @default(0)
  errorCount  Int        @default(0)
  message     String?
  createdAt   DateTime   @default(now())
  documents   Document[]
}

model Document {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadId       String?
  upload         Upload?        @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  model          String // 55 | 65 | 57 | NFSE
  key            String
  number         String
  series         String
  direction      String // entrada | saida
  issuedAt       DateTime
  natOp          String         @default("")
  emitterCnpj    String
  emitterName    String
  emitterCity    String         @default("")
  emitterCityCode String        @default("")
  emitterUf      String         @default("")
  emitterCrt     String?
  recipientCnpj  String         @default("")
  recipientName  String         @default("")
  recipientCity  String         @default("")
  recipientCityCode String      @default("")
  recipientUf    String         @default("")
  // Endereco, IE e dados extras do XML (usados no PDF da nota)
  emitterStreet     String      @default("")
  emitterNumber     String      @default("")
  emitterComplement String      @default("")
  emitterDistrict   String      @default("")
  emitterCep        String      @default("")
  emitterIe         String      @default("")
  recipientStreet     String    @default("")
  recipientNumber     String    @default("")
  recipientComplement String    @default("")
  recipientDistrict   String    @default("")
  recipientCep        String    @default("")
  recipientIe         String    @default("")
  exitAt         DateTime?
  protocolAt     DateTime?
  modFrete       String?
  additionalInfo String         @default("")
  /// so NFS-e: JSON com servico, ISS, retencoes (ver NfseData em src/xml/nfse-parser.ts)
  nfse           String?
  vProd          Float          @default(0)
  vFrete         Float          @default(0)
  vSeg           Float          @default(0)
  vDesc          Float          @default(0)
  vOutro         Float          @default(0)
  vIpi           Float          @default(0)
  total          Float          @default(0)
  vBc            Float          @default(0)
  vIcms          Float          @default(0)
  vPis           Float          @default(0)
  vCofins        Float          @default(0)
  vIbs           Float          @default(0)
  vCbs           Float          @default(0)
  cStat          String?
  protocol       String?
  cancelled      Boolean        @default(false)
  status         String         @default("pendente") // ok | erro | atencao | cancelada | pendente
  /// entrada: pode_creditar | credito_em_risco | nao_creditar · saida: correta | corrigir | cancelar_reemitir | cancelada
  verdict        String         @default("")
  auditedAt      DateTime?
  xml            String
  createdAt      DateTime       @default(now())
  items          DocumentItem[]
  findings       Finding[]

  @@unique([clientId, key])
  @@index([clientId, issuedAt])
}

model DocumentItem {
  id          String    @id @default(cuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  n           Int
  code        String    @default("")
  description String    @default("")
  ncm         String    @default("")
  cfop        String    @default("")
  unit        String    @default("")
  qty         Float     @default(0)
  unitValue   Float     @default(0)
  total       Float     @default(0)
  icmsTable   String? // CST | CSOSN
  cstIcms     String?
  vIcms       Float     @default(0)
  cstPis      String?
  vPis        Float     @default(0)
  cstCofins   String?
  vCofins     Float     @default(0)
  hasIbsCbs   Boolean   @default(false)
  cstIbsCbs   String?
  cClassTrib  String?
  pIbs        Float     @default(0)
  vIbs        Float     @default(0)
  pCbs        Float     @default(0)
  vCbs        Float     @default(0)
  findings    Finding[]
}

model Rule {
  id          String  @id @default(cuid())
  code        String  @unique
  field       String
  title       String
  kind        String  @default("tributaria") // tecnica | tributaria
  mode        String
  state       String  @default("interpretada") // publicada | interpretada
  severity    String  @default("erro") // erro | atencao | a_verificar
  /// JSON com a definicao do modo (mapa, dominio, condicao...)
  definition  String  @default("{}")
  description String
  what        String
  why         String
  how         String
  fixTag      String?
  legalBasis  String
  source      String?
  action      String  @default("conferir") // cancelar_reemitir | conferir
  active      Boolean @default(true)
  version     Int     @default(1)
}

model Finding {
  id         String        @id @default(cuid())
  documentId String
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId     String?
  item       DocumentItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ruleCode   String
  field      String
  kind       String
  severity   String // erro | atencao | a_verificar | ok
  observed   String
  expected   String
  createdAt  DateTime      @default(now())

  @@index([documentId])
  @@index([ruleCode, severity])
}

model AuditRun {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status     String    @default("RODANDO")
  total      Int       @default(0)
  processed  Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model Notification {
  id        String    @id @default(cuid())
  officeId  String
  userId    String?
  type      String
  title     String
  message   String
  link      String?
  severity  String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
